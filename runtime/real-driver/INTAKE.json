    "knownBehaviors": [
      {
        "what": "连接建立前发送消息会失败",
        "detail": "数据通道未 open 时引擎返回 E_NOT_READY，气泡显示 ⚠，输入框不回填。zsjws 原有语义，未改动。"
      },
      {
        "what": "握手耗时 4–9 秒",
        "detail": "取决于 TURN 分配与 peer-joined 下发时机；服务端偶发漏发 peer-joined 时会停在「正在建立连接」，驱动侧未做重试。"
      },
      {
        "what": "语音通话时控制条在屏幕顶部",
        "detail": "zsjws 原样：接通后 #callBanner 隐藏，.video 是 space-between，流内只剩 .controls。已在线上 zsjws 实测复现同一布局，非适配引入。"
      }
    ],
    "deviation": {
      "kind": "out-of-catalog",
      "what": "WebSocket",
      "where": [
        "src/engine/signaling/client.js",
        "src/engine/roster/index.js"
      ],
      "why": "母体能力目录无 ws: 项；声明目录外能力会在 authorize 阶段整包拒载。zsjws 的信令与房间通道都是 WebSocket，去掉业务即不可用。",
      "how": "不写进 capabilities，代码内直接 new WebSocket 直连，每处调用点标注 // capability: ws:<backend>",
      "mitigation": "母体侧 CSP 已放行 wss://quakeai.tech；README「能力与越界」有完整记录",
      "remediation": "母体补上 ws: 能力项后，改为声明式并走 ctx.ws"
    }
